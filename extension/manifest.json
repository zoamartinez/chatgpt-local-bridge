{
  "manifest_version": 3,
  "name": "ChatGPT Local Bridge",
  "version": "0.3.0",
  "description": "Puente local con aprobación humana para ChatGPT Web.",
  "permissions": ["nativeMessaging", "storage", "tabs", "scripting"],
  "host_permissions": ["https://chatgpt.com/*", "http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
